---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');

const SITE_URL = 'https://malfad.github.io/serious-studios';

const projects = [
  { title: 'Noir Botanicals', category: 'Branding', image: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800&q=80', href: '#', tall: false },
  { title: 'Vanta Architecture', category: 'Identity', image: 'https://images.unsplash.com/photo-1486325212027-8081e485255e?w=800&q=80', href: '#', tall: true },
  { title: 'Pulse Fashion', category: 'Art Direction', image: 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=800&q=80', href: '#', tall: false },
  { title: 'Forma Interiors', category: 'Brand System', image: 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=800&q=80', href: '#', tall: false },
  { title: 'Meridian Hospitality', category: 'Identity', image: 'https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?w=800&q=80', href: '#', tall: true },
  { title: 'Halo Skincare', category: 'Packaging', image: 'https://images.unsplash.com/photo-1570194065650-d99fb4bedf0a?w=800&q=80', href: '#', tall: false },
  { title: 'Crest Financial', category: 'Branding', image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&q=80', href: '#', tall: false },
  { title: 'Slate Collective', category: 'Art Direction', image: 'https://images.unsplash.com/photo-1561214115-f2f134cc4912?w=800&q=80', href: '#', tall: false },
  { title: 'Umbra Labs', category: 'Digital', image: 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=800&q=80', href: '#', tall: true },
];

// WebPage schema for homepage
const homePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE_URL}/#webpage`,
  url: `${SITE_URL}/`,
  name: 'Serious Studios — Creative Design Agency',
  description: 'Award-winning creative design studio specialising in brand identity, packaging, art direction, and digital design.',
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` }] },
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Serious Studios',
  url: `${SITE_URL}/`,
  description: 'Creative design studio delivering brand identity, packaging design, art direction, and digital design for ambitious brands.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Design Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Brand Identity Design' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Packaging Design' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Art Direction' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Digital Design' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Brand Systems' } },
    ],
  },
};
---
<Layout
  title="Serious Studios — Creative Design Agency"
  description="Award-winning creative design studio specialising in brand identity, packaging, art direction, and digital design for ambitious brands."
  type="website"
>
  <script type="application/ld+json" set:html={JSON.stringify(homePageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <Hero />
  <section class="work-grid" aria-label="Selected work">
    <div class="container">
      <div class="grid">
        {projects.map(p => <ProjectCard {...p} />)}
      </div>
      <div class="view-all">
        <a href={`${b}/work/`} class="btn">View all work</a>
      </div>
    </div>
  </section>
</Layout>

<style>
.work-grid { padding-bottom: 4rem; }
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--grid-gap);
}
.view-all { display: flex; justify-content: center; margin-top: 4rem; }
.btn {
  display: inline-block;
  border: 1.5px solid var(--color-text);
  padding: 0.9rem 2.5rem;
  font-size: 0.9rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: background var(--transition-base), color var(--transition-base);
}
.btn:hover { background: var(--color-text); color: var(--color-bg); }
@media (max-width: 1024px) { .grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px)  { .grid { grid-template-columns: 1fr; } }
</style>
