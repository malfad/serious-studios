---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title={post.data.title} description={post.data.excerpt}>
  <article class="post">
    {post.data.coverImage && (
      <div class="post__hero">
        <img src={post.data.coverImage} alt={post.data.title} />
      </div>
    )}
    <div class="container">
      <header class="post__header">
        <a href={`${b}/blog/`} class="post__back">← Journal</a>
        <span class="post__cat">{post.data.category}</span>
        <h1 class="post__title">{post.data.title}</h1>
        <div class="post__byline">
          <span class="post__author">{post.data.author}</span>
          <span> · </span>
          <time class="post__date" datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </header>
      <div class="post__body prose">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
.post { padding-bottom: 6rem; }
.post__hero {
  width: 100%;
  max-height: 520px;
  overflow: hidden;
  margin-bottom: 4rem;
}
.post__hero img { width: 100%; height: 520px; object-fit: cover; }

.post__header { max-width: 740px; margin: 0 auto 3rem; }
.post__back {
  display: inline-block;
  font-size: 0.85rem;
  color: var(--color-muted);
  margin-bottom: 2rem;
  transition: color var(--transition-base);
}
.post__back:hover { color: var(--color-text); }
.post__cat {
  display: block;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: 1rem;
}
.post__title {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin-bottom: 1.5rem;
}
.post__byline { font-size: 0.85rem; color: var(--color-muted); }
.post__author { font-weight: 600; color: var(--color-text); }

.post__body {
  max-width: 740px;
  margin: 0 auto;
}
.prose :global(h2) { font-size: 1.6rem; font-weight: 500; margin: 2.5rem 0 1rem; }
.prose :global(h3) { font-size: 1.2rem; font-weight: 600; margin: 2rem 0 0.75rem; }
.prose :global(p)  { margin-bottom: 1.5rem; line-height: 1.75; color: #222; }
.prose :global(ul), .prose :global(ol) { margin: 0 0 1.5rem 1.5rem; line-height: 1.75; }
.prose :global(li) { margin-bottom: 0.4rem; }
.prose :global(strong) { font-weight: 600; }
.prose :global(a) { text-decoration: underline; text-underline-offset: 3px; }
</style>
